# Local development and testing only:
#   cp .env.example .env && chmod 600 .env
# On Railway this file is NOT used: set Variables with the same names instead.
# Comments must stay on their own lines (python-dotenv misreads "KEY=  # comment").

# Bot token from @BotFather (/newbot). Turn on Bot Settings -> Business Mode.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (ask @userinfobot). Only this account is served.
OWNER_ID=

# false = PREVIEW: replies are only printed to the logs and data/previews.jsonl.
# true  = replies are sent from your account automatically.
AUTO_SEND=false

# Claude subscription token: the sk-ant-oat... value printed by `claude setup-token`.
# Create it once on a computer with a browser; it is valid for 1 year.
# Keep it like a password. Paste it with a text editor, on ONE line (not with echo).
# Never put an Anthropic API key (sk-ant-api...) here.
# Left empty: this machine's own `claude` login is used (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty: found on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Model alias or full name (e.g. sonnet, opus). Empty: the CLI default.
CLAUDE_MODEL=

# Reasoning effort: low, medium, high, xhigh or max.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before giving up.
CLAUDE_TIMEOUT_SECONDS=120

# Minutes to wait after a usage-limit error when Claude gives no reset time.
LIMIT_COOLDOWN_MINUTES=30

# Minutes the bot stays quiet in a chat after you write there yourself (0 = off).
OWNER_TAKEOVER_MINUTES=15

# Messages per chat kept as context.
HISTORY_LIMIT=30

# --- EduTizim balance lookup (optional; leave all empty to turn it off) ---
# Set these with: python edutizim_login.py   (asks for them with hidden input).
# apiKey issued by EduTizim for the External API.
EDUTIZIM_API_KEY=
# Bearer token of an EduTizim staff account (from edutizim_login.py; valid about 1 year).
EDUTIZIM_TOKEN=
# Comma-separated branch ids. Empty: all branches the account can see.
EDUTIZIM_BRANCH_IDS=

# --- Card for online payments (optional) ---
# Given to people who ask how to pay online; the bot always reminds them to send the receipt.
# Kept here / in Railway Variables, not in profile.md, so it is not in the GitHub repo.
PAYMENT_CARD=
PAYMENT_CARD_HOLDER=

# --- Contact numbers (optional) ---
# Finance department: given for payment problems.
MOLIYA_NOMER=
# Service desk: given for group changes, lesson times and other service questions.
SERVIS_NOMER=
